<?xml version="1.0" encoding="UTF-8"?>
<!-- logback-spring.xml — 统一日志配置：控制台 + 文件（按启动时间滚动） -->
<configuration scan="true" scanPeriod="30 seconds">

    <!-- 从 application.yml 读取应用名 -->
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="TraumChatRoom"/>

    <!-- 日志目录 -->
    <property name="LOG_DIR" value="./logs"/>
    <!-- 启动时间戳（精确到秒，用于区分每次启动的日志文件） -->
    <timestamp key="START_TIME" datePattern="yyyy-MM-dd_HH-mm"/>

    <!-- ============ 控制台输出 ============ -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%thread] %cyan(%logger{36}) - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ============ 主日志文件（按日期 + 启动时间滚动） ============ -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/app-${START_TIME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 按日期归档，每天一个压缩文件 -->
            <fileNamePattern>${LOG_DIR}/archived/app-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <!-- 单个文件最大 50MB -->
            <maxFileSize>50MB</maxFileSize>
            <!-- 最多保留 30 天 -->
            <maxHistory>30</maxHistory>
            <!-- 所有归档文件总大小上限 1GB -->
            <totalSizeCap>1GB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ============ 错误日志文件（仅 ERROR 级别） ============ -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/app-error-${START_TIME}.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archived/app-error-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ============ 开发环境：控制台 INFO + 文件 ============ -->
    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>
        <!-- 开发时 MyBatis/SQL 调试可打开 -->
        <logger name="com.tc.traumchatroom.mapper" level="DEBUG"/>
    </springProfile>

    <!-- ============ 生产环境：控制台 WARN + 文件 INFO ============ -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>
        <!-- 生产环境不输出控制台日志，减少 I/O -->
    </springProfile>

</configuration>
